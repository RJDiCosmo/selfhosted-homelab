# Copy to .env and fill in. Nothing here is a real secret.
# Services read the environment of their own container; a root .env file is not
# loaded automatically. Host scripts (mcp-token.py, tools/mcpcall.py) read the
# variables below from the process environment.

# --- bible-api --------------------------------------------------------------
# SQLite file. The database is not in this repo. Container default is /data/bibles.db.
DB_PATH=/data/bibles.db

# --- image-api --------------------------------------------------------------
# Required. Docker API for starting and stopping the ComfyUI container.
# Point this at a socket proxy, not at a raw docker.sock, if the service is reachable remotely.
DOCKER_HOST=tcp://docker-socket-proxy:2375
OUTPUT_DIR=/data
COMFYUI_CONTAINER=comfyui
COMFYUI_IDLE_TIMEOUT=600
IMAGE_RETENTION_DAYS=30
REMOTE_WAIT_SECONDS=40
STACK_API_URL=http://stack-api:8020
# Browser-reachable prefix for GET /images/{filename}. Trailing slash optional.
IMAGE_URL_BASE=https://chat.example.com/image-api/images/

# --- music-api --------------------------------------------------------------
# DOCKER_HOST is required here too (same meaning as image-api).
# DOCKER_HOST=tcp://docker-socket-proxy:2375
OUTPUT_DIR=/data
UPLOAD_DIR=/uploads
INBOX_DIR=/inbox
ACESTEP_CONTAINER=acestep
ACESTEP_GRADIO_CONTAINER=acestep-gradio
ACESTEP_XL_CONTAINER=acestep-xl
ACESTEP_XL_SFT_CONTAINER=acestep-xl-sft
STUDIO_UI_CONTAINER=studio-ui
COMFYUI_CONTAINER=comfyui
MUSIC_IDLE_TIMEOUT=600
MUSIC_RETENTION_DAYS=30
XL_IDLE_TIMEOUT=900
# "1" enables the LM planner / caption rewrite by default. Anything else is off.
XL_THINKING_DEFAULT=0
XL_COT_CAPTION=0
REMOTE_WAIT_SECONDS=40
DESCRIBE_LM=acestep-5Hz-lm-1.7B
DESCRIBE_TIMEOUT=600
STACK_API_URL=http://stack-api:8020
# Browser-reachable prefix for GET /audio/{filename}. Trailing slash optional.
AUDIO_URL_BASE=https://chat.example.com/music-api/audio/
# Origin of the studio UI. No path. Trailing slash is stripped.
STUDIO_PUBLIC_URL=https://studio.example.com
# Username posted to the studio UI's passwordless /api/auth/setup.
STUDIO_UI_USERNAME=studio

# --- stack-api --------------------------------------------------------------
# Required. Read-only Docker API (list, inspect, logs). stack-api has no write path of its own.
# DOCKER_HOST=tcp://docker-socket-proxy-ro:2375

# --- mcp-gateway ------------------------------------------------------------
# SHA-256 token store. Mount the hashes file here read-only. Do not put plaintext tokens in it.
TOKENS_FILE=/secrets/tokens.json
MAX_BODY_BYTES=1048576
RATE_LIMIT_PER_MIN=60

# --- mcp-gateway/mcp-token.py and tools/mcpcall.py (host) -------------------
# Directory for plaintext NAME.token files (mode 600) and store/tokens.json (hashes only).
MCP_GATEWAY_SECRETS=/run/secrets/mcp-gateway
# Public gateway origin used by `tools/mcpcall.py --remote`. No path.
MCP_PUBLIC_URL=https://mcp.example.com
# Optional. If set, mcpcall resolves MCP_PUBLIC_URL's host to this address.
# Leave empty to use normal DNS.
MCP_PUBLIC_IP=
# Host ports tools/mcpcall.py uses for local (non-remote) calls.
BIBLE_API_PORT=8001
IMAGE_API_PORT=8010
STACK_API_PORT=8020
MUSIC_API_PORT=8030
